{application, hecate_turn_credentials, [
    {description, "Mints short-lived TURN credentials for hecate-cam2me over the mesh"},
    {vsn, "0.1.0"},
    {registered, [hecate_turn_credentials_sup]},
    {mod, {hecate_turn_credentials_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        hecate_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-services/hecate-turn-credentials"}]}
]}.
